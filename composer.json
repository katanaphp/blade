{
    "name": "soysudhanshu/katana",
    "description": "Stadalone version of laravel Blade",
    "type": "library",
    "minimum-stability": "stable",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Blade\\": "src/",
            "Tests\\": "tests/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "symfony/var-dumper": "^5",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit"
    }
}
